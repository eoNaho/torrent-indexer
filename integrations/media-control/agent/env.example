LISTEN_HOST=127.0.0.1
LISTEN_PORT=8097
ALLOWED_NETWORKS=127.0.0.0/8,::1/128
STATE_DIR=/root/.local/share/media-control
STATUS_PROBE_FILE=/root/.local/share/media-control/host-status.json
STATUS_CLEAR_FILE=/root/.local/share/media-control/host-status.json.clear

# Set paths/URLs only for apps that are installed. API keys are read from each
# application's config file or the configured key file; do not put keys here.
BAZARR_CONFIG=/root/.config/Bazarr/config/config.yaml
BAZARR_URL=http://127.0.0.1:6767
BAZARR_KEY_FILE=/root/.config/Bazarr/.api-key
RADARR_URL=http://127.0.0.1:7878
RADARR_CONFIG=/root/.config/Radarr/config.xml
SONARR_URL=http://127.0.0.1:8989
SONARR_CONFIG=/root/.config/Sonarr/config.xml
SEERR_URL=http://127.0.0.1:5055
SEERR_CONFIG=/root/.config/Seerr/settings.json
